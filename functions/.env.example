# Salin file ini menjadi `.env` dan isi nilainya.
# File `.env` TIDAK boleh di-commit (sudah masuk .gitignore).

# Wajib: API key penyedia AI (DashScope / Alibaba Cloud Model Studio).
DASHSCOPE_API_KEY=isi_api_key_di_sini

# Opsional: dipakai untuk development lokal (Firebase Admin SDK).
FIREBASE_PROJECT_ID=ai-chatbot-be649

# Opsional: port server dev lokal.
PORT=3000

# Opsional: override model & endpoint AI.
# AI_MODEL=qwen3.8-max
# AI_BASE_URL=https://ws-gtnn1g4470a876t0.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Opsional: model khusus untuk membaca gambar (harus model vision/VL).
# Bila kosong, dipakai nilai AI_MODEL. Contoh: qwen-vl-max
# AI_VISION_MODEL=qwen-vl-max

# Opsional: mode "thinking" Qwen. Default false (lebih cepat).
# Set true bila ingin penalaran panjang.
# AI_ENABLE_THINKING=false

# Opsional: origin tambahan yang diizinkan (Flutter Web), pisahkan dengan koma.
# ALLOWED_ORIGINS=https://ai-chatbot-be649.web.app

# Opsional: batas rate limit.
# AI_RATE_LIMIT=30
# AI_RATE_WINDOW_MS=60000
