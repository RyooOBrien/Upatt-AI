<?xml version="1.0" encoding="utf-8"?>
<!--
  Hanya mengizinkan HTTP (cleartext) untuk host development lokal.
  Semua traffic lain wajib HTTPS (misalnya Cloud Functions).

  Untuk menguji dengan HP fisik lewat jaringan lokal, tambahkan IP
  komputer Anda di bawah ini, contoh:
      <domain includeSubdomains="true">192.168.1.10</domain>
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
